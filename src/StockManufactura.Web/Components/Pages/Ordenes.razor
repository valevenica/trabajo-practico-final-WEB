@page "/ordenes"
@attribute [Authorize]
@rendermode RenderModes.Interactivo
@inherits PaginaBase

<PageTitle>Órdenes de producción · StockManufactura</PageTitle>

<PaginaMarco Titulo="Órdenes de producción" Cargando="Cargando" AccesoDenegado="@AccesoDenegado">
    <div class="kpis">
        <div class="kpi"><span class="kpi-label">En proceso</span><span class="kpi-value">@_ordenes.Count(x => x.Estado == EstadoOrdenProduccion.EnProceso)</span></div>
        <div class="kpi"><span class="kpi-label">Finalizadas este mes</span><span class="kpi-value">@_ordenes.Count(x => x.Estado == EstadoOrdenProduccion.Finalizada && EsMesActual(x.FechaFin ?? x.UpdatedAt))</span></div>
        <div class="kpi"><span class="kpi-label">En espera</span><span class="kpi-value">@_ordenes.Count(x => EnEspera(x.Estado))</span></div>
        <div class="kpi" title="Promedio del tiempo que las órdenes finalizadas estuvieron en proceso (@_ordenesConTiempo órdenes)"><span class="kpi-label">Tiempo promedio de armado</span><span class="kpi-value">@(_tiempoPromedioArmado is { } t ? OrdenHistorial.FormatearDuracion(t) : "—")</span></div>
        <div class="kpi @(_stockCritico > 0 ? "kpi-alert" : "")"><span class="kpi-label">Stock crítico</span><span class="kpi-value">@_stockCritico</span></div>
    </div>

    <div class="split">
        <section class="card">
            <h2>@(_seleccionada is null ? "Nueva orden" : $"Orden {_seleccionada.Codigo}")</h2>
            <div class="form-grid">
                <div><label>Código (vacío = automático)</label><input @bind="_codigo" disabled="@(_seleccionada is not null)" /></div>
                <div>
                    <label>Cliente</label>
                    <select @bind="_clienteId">
                        <option value="">Consumidor final</option>
                        @foreach (var c in ClientesParaSelector)
                        {
                            <option value="@c.Id">@c.Nombre @(c.Activo ? "" : "(inactivo)")</option>
                        }
                    </select>
                </div>
                <div class="span-2"><label>Observaciones</label><textarea rows="2" @bind="_observaciones"></textarea></div>
            </div>

            <h3>Productos del pedido</h3>
            @if (LineasEditables)
            {
                <div class="inline-form">
                    <select @bind="_productoId">
                        @foreach (var p in _productos.Where(p => p.Activo))
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                    <input type="number" step="1" min="0" placeholder="Cantidad" @bind="_cantidad" />
                    <button class="btn btn-secondary" @onclick="AgregarLinea">+ Agregar producto</button>
                </div>
            }
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Stock</th><th class="num">Reservado</th>@if (LineasEditables) { <th></th> }</tr></thead>
                    <tbody>
                        @foreach (var l in _lineas)
                        {
                            var prod = _productos.FirstOrDefault(x => x.Id == l.ProductoId);
                            <tr>
                                <td>@(prod?.Nombre ?? "Producto eliminado") @if (prod is { Activo: false }) { <span class="badge badge-inactivo">Inactivo</span> }</td>
                                <td class="num">@l.Cantidad.ToString("0.##")</td>
                                <td class="num">@(prod?.StockActual.ToString("0.##") ?? "—")</td>
                                <td class="num" title="Unidades de este producto en órdenes en espera">@Reservado(l.ProductoId).ToString("0.##")</td>
                                @if (LineasEditables)
                                {
                                    <td class="row-actions"><button class="btn btn-link danger" @onclick="() => _lineas.Remove(l)">Quitar</button></td>
                                }
                            </tr>
                        }
                        @if (_lineas.Count == 0)
                        {
                            <tr><td colspan="5" class="muted">Agregá al menos un producto.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-actions wrap">
                @if (_seleccionada is null)
                {
                    <button class="btn btn-primary" disabled="@Ocupado" @onclick="() => EjecutarAsync(CrearAsync)">Crear orden</button>
                }
                else
                {
                    <span>Estado: <EstadoOrdenBadge Estado="_seleccionada.Estado" /></span>
                    @if (LineasEditables)
                    {
                        <button class="btn btn-secondary" disabled="@Ocupado" @onclick="() => EjecutarAsync(GuardarLineasAsync)">Guardar productos</button>
                    }
                    @if (_seleccionada.Estado == EstadoOrdenProduccion.Finalizada)
                    {
                        @* Una orden finalizada forma parte del historial: solo puede reabrirse para seguir en proceso. *@
                        <button class="btn btn-primary" disabled="@Ocupado" @onclick="() => EjecutarAsync(ReabrirAsync)">Reabrir (volver a en proceso)</button>
                    }
                    else if (_seleccionada.Estado == EstadoOrdenProduccion.Cancelada)
                    {
                        <button class="btn btn-primary" disabled="@Ocupado" @onclick="() => EjecutarAsync(RestaurarAsync)">Restaurar a «@TextoEstado(_seleccionada.EstadoParaRestaurar)»</button>
                        <button class="btn btn-secondary danger" disabled="@Ocupado" @onclick="() => EjecutarAsync(EliminarAsync)">Eliminar</button>
                    }
                    else
                    {
                        @if (_seleccionada.Estado != EstadoOrdenProduccion.Borrador)
                        {
                            <button class="btn btn-secondary" disabled="@Ocupado" @onclick="() => EjecutarAsync(BorradorAsync)">Borrador</button>
                        }
                        @if (_seleccionada.Estado != EstadoOrdenProduccion.Planificada)
                        {
                            <button class="btn btn-secondary" disabled="@Ocupado" @onclick="() => EjecutarAsync(PlanificarAsync)">Planificar</button>
                        }
                        @if (_seleccionada.Estado != EstadoOrdenProduccion.EnProceso)
                        {
                            <button class="btn btn-secondary" disabled="@Ocupado" @onclick="() => EjecutarAsync(IniciarAsync)">Iniciar</button>
                        }
                        <button class="btn btn-primary" disabled="@Ocupado" @onclick="() => EjecutarAsync(FinalizarAsync)">Finalizar</button>
                        <button class="btn btn-secondary" disabled="@Ocupado" @onclick="() => EjecutarAsync(CancelarAsync)">Cancelar orden</button>
                        <button class="btn btn-secondary" disabled="@Ocupado" @onclick="() => EjecutarAsync(AsignarClienteAsync)">Asignar cliente</button>
                        @if (_seleccionada.Estado != EstadoOrdenProduccion.EnProceso)
                        {
                            <button class="btn btn-secondary danger" disabled="@Ocupado" @onclick="() => EjecutarAsync(EliminarAsync)">Eliminar</button>
                        }
                    }
                    <button class="btn btn-link" @onclick="NuevaOrden">Nueva orden</button>
                }
            </div>
            <StatusBar Mensaje="@StatusMessage" />

            @if (_seleccionada is not null)
            {
                <h3>Historial de estados</h3>
                @if (TiempoDeArmadoSeleccionada is { } armado)
                {
                    <p class="muted">Tiempo de armado: @OrdenHistorial.FormatearDuracion(armado)</p>
                }
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>Fecha</th><th>Cambio</th><th>Usuario</th></tr></thead>
                        <tbody>
                            @foreach (var c in HistorialSeleccionada.OrderByDescending(x => x.Fecha))
                            {
                                <tr>
                                    <td>@c.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(c.EstadoAnterior is { } previo ? $"{TextoEstado(previo)} → " : "Alta → ")<EstadoOrdenBadge Estado="c.EstadoNuevo" /></td>
                                    <td>@c.Usuario</td>
                                </tr>
                            }
                            @if (HistorialSeleccionada.Count == 0)
                            {
                                <tr><td colspan="3" class="muted">Sin cambios registrados: la orden es anterior al historial (creada el @_seleccionada.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")).</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="card">
            <h2>Órdenes</h2>
            <div class="table-wrap">
                <table class="table selectable">
                    <thead><tr><th>Código</th><th>Producto</th><th>Cliente</th><th class="num">Cant.</th><th>Estado</th><th>Creada</th></tr></thead>
                    <tbody>
                        @foreach (var o in _ordenes)
                        {
                            <tr class="@(o.Id == _seleccionada?.Id ? "selected" : "")" @onclick="() => Seleccionar(o)">
                                <td class="code">@o.Codigo</td>
                                <td>@ResumenProductos(o)</td>
                                <td>@(o.ClienteId is { } c ? _clientes.FirstOrDefault(x => x.Id == c)?.Nombre ?? "—" : "Consumidor final")</td>
                                <td class="num">@o.CantidadPlaneada.ToString("0.##")</td>
                                <td><EstadoOrdenBadge Estado="o.Estado" /></td>
                                <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                        @if (_ordenes.Count == 0)
                        {
                            <tr><td colspan="6" class="muted">Sin órdenes.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</PaginaMarco>

@code {
    protected override string Modulo => ModuleAccess.ProductionOrders;

    private List<Producto> _productos = new();
    private List<Cliente> _clientes = new();
    private List<OrdenProduccion> _ordenes = new();
    private OrdenProduccion? _seleccionada;
    private int _stockCritico;
    private ILookup<Guid, OrdenProduccionCambioEstado> _historial = Array.Empty<OrdenProduccionCambioEstado>().ToLookup(x => x.OrdenProduccionId);
    private TimeSpan? _tiempoPromedioArmado;
    private int _ordenesConTiempo;

    private IReadOnlyCollection<OrdenProduccionCambioEstado> HistorialDe(Guid ordenId) => _historial[ordenId].ToList();
    private IReadOnlyCollection<OrdenProduccionCambioEstado> HistorialSeleccionada => _seleccionada is null ? Array.Empty<OrdenProduccionCambioEstado>() : HistorialDe(_seleccionada.Id);
    private TimeSpan? TiempoDeArmadoSeleccionada => _seleccionada is null ? null : OrdenHistorial.TiempoDeArmado(_seleccionada, HistorialSeleccionada);

    private static string TextoEstado(EstadoOrdenProduccion e) => e switch
    {
        EstadoOrdenProduccion.Borrador => "Borrador",
        EstadoOrdenProduccion.Planificada => "Planificada",
        EstadoOrdenProduccion.EnProceso => "En proceso",
        EstadoOrdenProduccion.Finalizada => "Finalizada",
        EstadoOrdenProduccion.Cancelada => "Cancelada",
        _ => e.ToString()
    };

    private string _codigo = string.Empty;
    private Guid _productoId;
    private decimal _cantidad;
    private string _clienteId = string.Empty;
    private string _observaciones = string.Empty;

    private IUnitOfWork UnitOfWork => Servicio<IUnitOfWork>();

    private List<Linea> _lineas = new();

    private Producto? ProductoElegido => _productos.FirstOrDefault(x => x.Id == _productoId);

    // Los productos se pueden cambiar mientras la orden no movió stock: al crearla y mientras sigue en espera.
    private bool LineasEditables => _seleccionada is null || EnEspera(_seleccionada.Estado);

    // Las órdenes nuevas solo ofrecen clientes activos; una orden existente muestra el suyo aunque esté inactivo.
    private IEnumerable<Cliente> ClientesParaSelector => _clientes.Where(c => c.Activo || c.Id == _seleccionada?.ClienteId);

    protected override async Task CargarAsync()
    {
        _productos = (await UnitOfWork.Productos.ListAsync()).OrderBy(x => x.Nombre).ToList();
        _clientes = (await UnitOfWork.Clientes.ListAsync()).OrderBy(x => x.Nombre).ToList();
        _ordenes = (await UnitOfWork.OrdenesProduccion.ListByCreatedDescAsync()).ToList();
        _stockCritico = (await Servicio<IShortageService>().GetShortagesAsync()).TotalCount;

        _historial = (await UnitOfWork.CambiosEstadoOrden.ListAsync()).ToLookup(x => x.OrdenProduccionId);
        var tiempos = _ordenes
            .Select(o => OrdenHistorial.TiempoDeArmado(o, HistorialDe(o.Id)))
            .Where(t => t.HasValue)
            .Select(t => t!.Value)
            .ToList();
        _ordenesConTiempo = tiempos.Count;
        _tiempoPromedioArmado = tiempos.Count > 0 ? TimeSpan.FromTicks((long)tiempos.Average(t => t.Ticks)) : null;

        if (_seleccionada is not null)
        {
            _seleccionada = _ordenes.FirstOrDefault(x => x.Id == _seleccionada.Id);
        }

        if (_seleccionada is null && ProductoElegido is not { Activo: true })
        {
            _productoId = _productos.FirstOrDefault(x => x.Activo)?.Id ?? Guid.Empty;
        }
    }

    private static bool EnEspera(EstadoOrdenProduccion e) => e is EstadoOrdenProduccion.Borrador or EstadoOrdenProduccion.Planificada;

    private static bool EsMesActual(DateTime value)
    {
        var now = DateTime.UtcNow;
        return value.Year == now.Year && value.Month == now.Month;
    }

    private string NombreProducto(Guid id) => _productos.FirstOrDefault(x => x.Id == id)?.Nombre ?? "—";

    private string ResumenProductos(OrdenProduccion o) => o.Items.Count == 1
        ? NombreProducto(o.Items.First().ProductoId)
        : string.Join(", ", o.Items.Select(i => $"{NombreProducto(i.ProductoId)} ×{i.Cantidad:0.##}"));

    private decimal Reservado(Guid productoId)
        => _ordenes.Where(o => EnEspera(o.Estado)).SelectMany(o => o.Items).Where(i => i.ProductoId == productoId).Sum(i => i.Cantidad);

    private void AgregarLinea()
    {
        if (ProductoElegido is not { Activo: true } producto) { StatusMessage = "Seleccioná un producto."; return; }
        if (_cantidad <= 0) { StatusMessage = "Ingresá una cantidad mayor a cero."; return; }

        // El mismo producto agregado de nuevo suma su cantidad a la línea existente.
        var existente = _lineas.FirstOrDefault(x => x.ProductoId == producto.Id);
        if (existente is not null) { existente.Cantidad += _cantidad; }
        else { _lineas.Add(new Linea { ProductoId = producto.Id, Cantidad = _cantidad }); }

        _cantidad = 0;
        StatusMessage = string.Empty;
    }

    private void Seleccionar(OrdenProduccion o)
    {
        _seleccionada = o;
        _codigo = o.Codigo;
        _lineas = o.Items.Select(i => new Linea { ProductoId = i.ProductoId, Cantidad = i.Cantidad }).ToList();
        _cantidad = 0;
        _clienteId = o.ClienteId?.ToString() ?? string.Empty;
        _observaciones = o.Observaciones;
        StatusMessage = string.Empty;
    }

    private void NuevaOrden()
    {
        _seleccionada = null;
        _lineas = new();
        _cantidad = 0;
        _observaciones = string.Empty;
        _clienteId = string.Empty;
        if (ProductoElegido is not { Activo: true })
        {
            _productoId = _productos.FirstOrDefault(x => x.Activo)?.Id ?? Guid.Empty;
        }
        StatusMessage = "Nueva orden. Agregá los productos del pedido con su cantidad.";
    }

    private Guid? ClienteElegido => Guid.TryParse(_clienteId, out var id) ? id : null;

    private async Task CrearAsync()
    {
        if (_lineas.Count == 0) { StatusMessage = "Agregá al menos un producto al pedido."; return; }

        var codigo = string.IsNullOrWhiteSpace(_codigo) ? GenerarCodigo() : _codigo.Trim().ToUpperInvariant();
        if (_ordenes.Any(x => string.Equals(x.Codigo, codigo, StringComparison.OrdinalIgnoreCase))) { StatusMessage = $"Ya existe una orden con el código {codigo}."; return; }

        var orden = new OrdenProduccion(codigo, _lineas.Select(l => (l.ProductoId, l.Cantidad)), _observaciones.Trim(), ClienteElegido);
        await UnitOfWork.OrdenesProduccion.AddAsync(orden);
        await OrdenHistorial.RegistrarAsync(UnitOfWork, orden, null, Session.Actor);
        await UnitOfWork.SaveChangesAsync();
        await RegistrarAuditoriaAsync("Crear", orden, "Alta de orden de producción.");

        await CargarAsync();
        // Queda seleccionada para poder avanzarla de estado enseguida.
        Seleccionar(_ordenes.First(x => x.Id == orden.Id));
        StatusMessage = await AvisoStockAsync($"Orden {codigo} creada.", orden);
    }

    private async Task GuardarLineasAsync()
    {
        if (_seleccionada is null) { return; }
        if (_lineas.Count == 0) { StatusMessage = "La orden debe tener al menos un producto."; return; }

        var orden = _seleccionada;
        try
        {
            orden.ReemplazarItems(_lineas.Select(l => (l.ProductoId, l.Cantidad)));
            await UnitOfWork.OrdenesProduccion.ActualizarConItemsAsync(orden);
            await UnitOfWork.SaveChangesAsync();
            await RegistrarAuditoriaAsync("EditarProductos", orden, $"Productos del pedido: {ResumenProductos(orden)}.");
        }
        catch (InvalidOperationException ex)
        {
            var error = ex.Message;
            await CargarAsync();
            if (_seleccionada is not null) { Seleccionar(_seleccionada); }
            StatusMessage = error;
            return;
        }

        await CargarAsync();
        Seleccionar(_ordenes.First(x => x.Id == orden.Id));
        StatusMessage = await AvisoStockAsync($"Productos de la orden {orden.Codigo} actualizados.", orden);
    }

    /// <summary>
    /// Avisa qué productos del pedido no alcanzan (considerando otras órdenes en espera) y, solo como información, si los
    /// insumos alcanzan para fabricar las unidades faltantes.
    /// </summary>
    private async Task<string> AvisoStockAsync(string encabezado, OrdenProduccion orden)
    {
        var faltantesProductos = new List<string>();
        var requeridoPorInsumo = new Dictionary<Guid, (Recurso Recurso, decimal Requerido)>();
        foreach (var item in orden.Items)
        {
            var producto = _productos.FirstOrDefault(x => x.Id == item.ProductoId);
            if (producto is null) { continue; }

            var faltante = Reservado(producto.Id) - producto.StockActual;
            if (faltante <= 0) { continue; }

            faltantesProductos.Add($"{producto.Nombre} (faltan {faltante:0.##} unidades)");
            foreach (var receta in (await UnitOfWork.RecetaProductoItems.ListByProductIdAsync(producto.Id)).Where(x => x.RecursoId.HasValue))
            {
                var recurso = await UnitOfWork.Recursos.GetByIdAsync(receta.RecursoId!.Value);
                if (recurso is null || recurso.EsServicio) { continue; }

                var previo = requeridoPorInsumo.TryGetValue(recurso.Id, out var acumulado) ? acumulado.Requerido : 0m;
                requeridoPorInsumo[recurso.Id] = (recurso, previo + receta.Cantidad * faltante);
            }
        }

        if (faltantesProductos.Count == 0)
        {
            return encabezado;
        }

        var aviso = $"{encabezado} Queda en espera: falta stock para completar el pedido (considerando otras órdenes en espera): {string.Join(", ", faltantesProductos)}.";
        var insumosQueNoAlcanzan = requeridoPorInsumo.Values
            .Where(x => x.Recurso.StockActual < x.Requerido)
            .Select(x => $"{x.Recurso.Nombre} (faltan {x.Requerido - x.Recurso.StockActual:0.##} {x.Recurso.UnidadMedida})")
            .ToList();
        if (insumosQueNoAlcanzan.Count > 0)
        {
            aviso += $" Además, no alcanzan los insumos para fabricar esas unidades: {string.Join(", ", insumosQueNoAlcanzan)}.";
        }

        await JS.InvokeVoidAsync("alert", aviso);
        return aviso;
    }

    private async Task TransicionAsync(Action<OrdenProduccion> transicion, string accion, string mensaje)
    {
        if (_seleccionada is null) { StatusMessage = "Debe seleccionar una orden."; return; }

        var orden = _seleccionada;
        try
        {
            var estadoAnterior = orden.Estado;
            var observaciones = _observaciones.Trim();
            if (!string.Equals(orden.Observaciones, observaciones, StringComparison.Ordinal))
            {
                orden.ActualizarObservaciones(observaciones);
            }

            transicion(orden);
            await OrdenStock.AplicarMovimientoAsync(UnitOfWork, estadoAnterior, orden);
            await OrdenHistorial.RegistrarAsync(UnitOfWork, orden, estadoAnterior, Session.Actor);
            UnitOfWork.OrdenesProduccion.Update(orden);
            await UnitOfWork.SaveChangesAsync();
            await RegistrarAuditoriaAsync(accion, orden, mensaje);
            StatusMessage = mensaje;
        }
        catch (InvalidOperationException ex)
        {
            StatusMessage = ex.Message;
        }

        // Se recarga siempre: si la transición falló, descarta el estado que quedó cambiado en memoria.
        var mensajeFinal = StatusMessage;
        await CargarAsync();
        if (_seleccionada is not null) { Seleccionar(_seleccionada); }
        StatusMessage = mensajeFinal;
    }

    private Task BorradorAsync() => TransicionAsync(o => o.VolverABorrador(), "Borrador", "Orden regresada a borrador.");
    private Task PlanificarAsync() => TransicionAsync(o => o.Planificar(), "Planificada", "Orden planificada.");
    private Task IniciarAsync() => TransicionAsync(o => o.MarcarEnProgreso(), "EnProceso", "Orden en proceso.");
    private Task FinalizarAsync() => TransicionAsync(o => o.Completar(), "Finalizada", "Orden finalizada.");
    private Task ReabrirAsync() => TransicionAsync(o => o.Reabrir(), "Reabrir", "Orden reabierta: vuelve a en proceso.");

    private Task RestaurarAsync()
    {
        var destino = _seleccionada is null ? string.Empty : TextoEstado(_seleccionada.EstadoParaRestaurar);
        return TransicionAsync(o => o.RestaurarCancelada(), "Restaurar", $"Orden restaurada a «{destino}».");
    }

    private Task CancelarAsync()
    {
        var motivo = string.IsNullOrWhiteSpace(_observaciones) ? "Cancelada desde módulo de producción." : _observaciones;
        return TransicionAsync(o => o.Cancelar(motivo), "Cancelada", "Orden cancelada.");
    }

    private async Task AsignarClienteAsync()
    {
        if (_seleccionada is null) { StatusMessage = "Seleccione el pedido al que quiere asignar el cliente."; return; }

        var orden = _seleccionada;
        try
        {
            orden.AsignarCliente(ClienteElegido);
            UnitOfWork.OrdenesProduccion.Update(orden);
            await UnitOfWork.SaveChangesAsync();
            var nombre = ClienteElegido is { } id ? _clientes.FirstOrDefault(x => x.Id == id)?.Nombre ?? "—" : "Consumidor final";
            await RegistrarAuditoriaAsync("AsignarCliente", orden, $"Cliente del pedido: «{nombre}».");
            StatusMessage = $"Pedido {orden.Codigo} asignado al cliente «{nombre}».";
        }
        catch (InvalidOperationException ex)
        {
            StatusMessage = ex.Message;
        }

        await CargarAsync();
    }

    private async Task EliminarAsync()
    {
        if (_seleccionada is null) { return; }

        var orden = _seleccionada;
        if (orden.Estado == EstadoOrdenProduccion.EnProceso) { StatusMessage = "No se puede eliminar una orden en proceso. Cancelala primero para liberar el stock reservado."; return; }
        if (orden.Estado == EstadoOrdenProduccion.Finalizada) { StatusMessage = "No se pueden eliminar órdenes finalizadas; forman parte del historial."; return; }
        if (!await ConfirmarAsync($"¿Eliminar la orden '{orden.Codigo}'? Esta acción no se puede deshacer.")) { return; }

        UnitOfWork.OrdenesProduccion.Delete(orden);
        await UnitOfWork.SaveChangesAsync();
        await RegistrarAuditoriaAsync("Eliminar", orden, "Orden eliminada.");
        _seleccionada = null;
        await CargarAsync();
        NuevaOrden();
        StatusMessage = "Orden eliminada.";
    }

    private string GenerarCodigo()
    {
        var secuencia = _ordenes.Count(x => x.CreatedAt.Date == DateTime.UtcNow.Date) + 1;
        return $"OP-{DateTime.UtcNow:yyyyMMdd}-{secuencia:000}";
    }

    private Task RegistrarAuditoriaAsync(string accion, OrdenProduccion orden, string descripcion)
    {
        return Servicio<IAuditLogService>().RegisterAsync(new AuditLog
        {
            Usuario = Session.Actor,
            Modulo = "Produccion",
            Accion = accion,
            Entidad = "OrdenProduccion",
            IdEntidad = orden.Id.ToString(),
            Descripcion = descripcion,
            Equipo = WebSession.Equipo
        });
    }

    private sealed class Linea
    {
        public Guid ProductoId { get; init; }
        public decimal Cantidad { get; set; }
    }
}
