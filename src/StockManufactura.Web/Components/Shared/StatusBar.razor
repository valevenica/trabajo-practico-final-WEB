@* Mensaje de resultado dentro de la página; los errores se resaltan en rojo y se anuncian a los lectores de pantalla. *@
@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="status @(Error ? "status-error" : "")" role="@(Error ? "alert" : "status")">@Mensaje</div>
}

@code {
    [Parameter] public string? Mensaje { get; set; }
    [Parameter] public bool Error { get; set; }
}
